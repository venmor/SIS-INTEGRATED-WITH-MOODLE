# Phase 0 toolchain baseline — variable NAMES only, no values.
# Copy to .env locally and fill in. Never commit .env.
# Chitindu: use Node 24.21.0 + Postgres 18 to match this baseline.

DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Demo-only recovery-token completion (never true outside local demo).
DEMO_MODE=
# Web proxy target for API calls (server-side only, never NEXT_PUBLIC).
API_INTERNAL_URL=

# Application scanning: blank uses ClamAV; demo-fixtures requires DEMO_MODE=true.
# Only the exact bundled fictional PDF is accepted by the demo adapter.
APPLICATION_SCANNER=
# Payment-simulator callback secret (HMAC, demo only; never a real key).
# Required for callbacks + simulator dispatch; tests use a fixture value.
FIN_SIM_SECRET=
# Live Moodle connection. Leave BOTH URL and token blank for simulator mode.
# Set BOTH for live read/validation mode. Setting only one is a configuration
# error so production can never silently fall back to the simulator.
# SIS never writes the token to application logs or the database.
MOODLE_API_URL=
MOODLE_API_TOKEN=
# Live mode is READ-ONLY by default. Set true only after Test connection,
# role ids, category and mappings have been verified on the target Moodle.
MOODLE_LIVE_WRITES=false
# Destination Moodle course category id for SIS-created shells.
# Required before live writes are enabled; read it from the target Moodle.
MOODLE_CATEGORY_ID=
# Instance-specific numeric role ids as JSON. Read these from the target
# Moodle instance; never copy role ids from another site.
# Example shape only: {"Teacher":3,"Tutor":4,"Non-editing Teacher":4,"Student":5}
MOODLE_ROLE_IDS=
# Optional API listen port; default 3001.
PORT=
