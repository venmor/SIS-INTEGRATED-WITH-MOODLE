# Phase 0 toolchain baseline — variable NAMES only, no values.
# Copy to .env locally and fill in. Never commit .env.
# Chitundu: use Node 24.21.0 + Postgres 18 to match this baseline.

DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Demo-only recovery-token completion (never true outside local demo).
DEMO_MODE=
# Web proxy target for API calls (server-side only, never NEXT_PUBLIC).
API_INTERNAL_URL=

# Application scanning: blank uses ClamAV; demo-fixtures requires DEMO_MODE=true.
# Only the exact bundled fictional PDF is accepted by the demo adapter.
APPLICATION_SCANNER=
# Payment-simulator callback secret (HMAC, demo only; never a real key).
# Required for callbacks + simulator dispatch; tests use a fixture value.
FIN_SIM_SECRET=
# Moodle integration (MOODLE-LIVE-TEST-v1): explicit mode, fail-closed.
# The simulator is the default and makes no Moodle request. The live-test
# target is deliberately unconfirmed, so every value below is an EMPTY
# PLACEHOLDER until the target is confirmed, and no hostname, site id,
# release, role id, category id or token is recorded here. An empty value
# is what proves live mode cannot be armed from this file.
# MOODLE_INTEGRATION_MODE: the only live value is live-test. Absent or
#   simulator selects the simulator before any other check; any other
#   value, including the legacy live, refuses with MODE_INVALID.
MOODLE_INTEGRATION_MODE=
# MOODLE_API_URL: a bare https origin — no path, userinfo, query or
#   fragment. Refuses with URL_NOT_HTTPS, URL_HAS_PATH, URL_HAS_USERINFO
#   or URL_HAS_QUERY. The hostname must match MOODLE_ALLOWED_HOST.
MOODLE_API_URL=
# MOODLE_API_TOKEN: the Moodle web-service token. Refuses with
#   TOKEN_MISSING when empty. Held in the process environment only; never
#   stored in a row, logged, returned or audit-recorded.
MOODLE_API_TOKEN=
# MOODLE_ALLOWED_HOST: comma-separated exact hosts. The URL host and every
#   entry are normalized (case, one trailing dot, IDN/punycode) before an
#   exact comparison; a subdomain or suffix never matches. A missing,
#   empty or malformed list or entry refuses with HOST_NOT_ALLOWED.
MOODLE_ALLOWED_HOST=
# MOODLE_EXPECTED_SITE_ID: the site-course SITEID, a positive integer with
#   no decimal point. Refuses with SITE_ID_INVALID. It is not proof of a
#   unique tenant; the hostname is.
MOODLE_EXPECTED_SITE_ID=
# MOODLE_EXPECTED_VERSION: the exact Moodle release string, compared
#   verbatim. Refuses with RELEASE_MISSING.
MOODLE_EXPECTED_VERSION=
# MOODLE_ROLE_IDS: JSON object of Moodle role shortname to positive integer
#   id, e.g. {"Student":5}. Every value must be a positive integer.
#   Refuses with ROLE_IDS_INVALID; a role is never defaulted.
MOODLE_ROLE_IDS=
# MOODLE_CATEGORY_ID: the course category id, a positive integer. Refuses
#   with CATEGORY_INVALID.
MOODLE_CATEGORY_ID=
# MOODLE_COURSE_VISIBLE: exactly 0 or 1, whether a created test course is
#   visible. Refuses with VISIBILITY_INVALID.
MOODLE_COURSE_VISIBLE=
# MOODLE_LIVE_TEST_RUN_ID: the identifier of this live-test run, so a
#   prepared run cannot be started against a different configuration.
#   Refuses with RUN_ID_MISSING.
MOODLE_LIVE_TEST_RUN_ID=
# MOODLE_LIVE_TEST_DB_FINGERPRINT: the non-secret database identity, 64
#   lowercase hex characters. Refuses with DB_FINGERPRINT_MISSING.
MOODLE_LIVE_TEST_DB_FINGERPRINT=
# MOODLE_LIVE_TEST_COHORT_PREFIX: the reserved live-test cohort namespace.
#   Must equal the policy constant exactly and case-sensitively; it is
#   never derived from a course, user or run. Refuses with
#   COHORT_PREFIX_MISMATCH.
MOODLE_LIVE_TEST_COHORT_PREFIX=
# MOODLE_REAUTH_MODE: fresh-authentication enforcement for the run state
#   machine (REQ-IAM-005). Deliberately NOT a requiredEnv variable: it
#   defaults to session-age, so omitting it is meaningful. Ships disabled.
MOODLE_REAUTH_MODE=
# Optional API listen port; default 3001.
PORT=
