{
  "name": "unza-sis-moodle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SIS integrated with Moodle — identity, programme discovery and applicant self-service",
  "engines": {
    "node": "24.21.0",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Run both shells (two terminals, Windows-safe): npm run dev:web AND npm run dev:api\" && exit 0",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace=@sis/config && npm run build --workspace=web --workspace=api",
    "demo:reset": "node scripts/demo-reset.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "backup:test": "node scripts/backup-test.mjs",
    "postinstall": "node scripts/with-env.mjs prisma generate",
    "test:scripts": "node --test scripts/*.test.mjs",
    "scan": "node scripts/check-source.mjs",
    "test:browser": "node scripts/with-env.mjs playwright test",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "prisma": {
    "seed": "node prisma/seed/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "7.10.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "pg": "8.23.0"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true
  }
}
