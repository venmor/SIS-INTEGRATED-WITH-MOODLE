{
  "name": "unza-sis-moodle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SIS integrated with Moodle — modular monolith (Phase 0 shells, no business logic yet)",
  "engines": {
    "node": "24.21.0",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Run both shells (two terminals, Windows-safe): npm run dev:web AND npm run dev:api\" && exit 0",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace=apps/web --workspace=apps/api",
    "demo:reset": "node scripts/demo-reset.mjs",
    "postinstall": "node scripts/with-env.mjs prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed/seed.ts"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "pg": "8.23.0"
  }
}
