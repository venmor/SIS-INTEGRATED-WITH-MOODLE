// the partial unique index in migration 20260927090000 — same
// hand-maintained pattern as ReviewRecommendation). Mappings bind one
// Moodle activity to one approved component (DRAFT→TESTED→ACTIVE under
// four-eyes; one ACTIVE per component, same partial-unique pattern).
// ASSESSMENT-DEMO-v1 values are fictional (SUP-009, GAP-022).
model AssessmentPlan {
  id String @id @default(uuid())
  offeringRef String
  periodCode String
  version Int @default(1)
  status String @default("DRAFT")
  policyVersion String
  createdByAccountId String
  approvedByAccountId String?
  createdAt DateTime @default(now())
  approvedAt DateTime?
  components AssessmentComponent[]
  @@unique([offeringRef, periodCode, version])
  @@index([offeringRef, periodCode, status])
}

