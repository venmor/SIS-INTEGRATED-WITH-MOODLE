// Phase 7 slice 2: Moodle grade staging snapshot (TASK-PH7-002).
// Immutable batches per ACTIVE mapping + source revision (one batch per
// mapping+revision; replay returns stored batch). Lines carry DS5 §4
// provenance (raw value, outcome code, converted value kept null until
// validation); quarantine flags isolate invalid lines while preserving
// valid ones (TEST-REC-003). Staging never makes results official.
// Phase 7 slice 2: frozen DS5 §4 provenance (TASK-PH7-002). Batches
// freeze the source and SIS coordinates in force at stage time, so later
// supersedes never rewrite the snapshot. Lines record the resolved SIS
// identity (null stays MOODLE_ONLY evidence) and the applied formula.
model GradeBatch {
  id String @id @default(uuid())
  mappingId String
  mapping GradeActivityMapping @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  sourceRevision String
  status String @default("RECEIVED")
  version Int @default(1)
  createdByAccountId String
  createdAt DateTime @default(now())
  moodleInstance String @default("MOODLE-SIM-v1")
  moodleCourseRef String @default("")
  moodleActivityId String @default("")
  offeringRef String @default("")
  periodCode String @default("")
  componentCode String @default("")
  planVersion Int @default(1)
  policyVersion String @default("ASSESSMENT-DEMO-v1")
  sourceResponse Json @default("{}")
  // Phase 7 slice 3: validation outcome (TASK-PH7-003). resultState carries
  // MISSING_MARKS while missing-mark findings stay open, else null.
  // Validation never edits lines; corrections stage new revisions.
  resultState String?
  validatedAt DateTime?
  validatedByAccountId String?
  // Phase 7 slice 4: moderation lock (TASK-PH7-004). Set on approval;
  // corrections stage new revisions, never edits.
  lockedAt DateTime?
  lines GradeLine[]
  findings GradeFinding[]
  moderationCase ModerationCase?
  @@unique([mappingId, sourceRevision])
  @@index([mappingId, status])
}

model GradeLine {
  id String @id @default(uuid())
  batchId String
  batch GradeBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  studentRef String
  rawValue Float?
  outcome String @default("MARK_RECORDED")
  convertedValue Float?
  conversionFormula String?
  resolvedStudentId String?
  resolvedStudent Student? @relation(fields: [resolvedStudentId], references: [id], onDelete: Restrict)
  resolvedAccountId String?
  resolvedAccount Account? @relation(fields: [resolvedAccountId], references: [id], onDelete: Restrict)
  status String @default("STAGED")
  flagCode String?
  createdAt DateTime @default(now())
  findings GradeFinding[]
  @@unique([batchId, studentRef])
  @@index([batchId, status])
  @@index([resolvedStudentId])
}

// Phase 7 slice 3: immutable validation findings per staged batch
// (TASK-PH7-003). Findings triage OPEN→ACKNOWLEDGED→RESOLVED/DISMISSED
// with version checks; resolve/dismiss demand a reason. Lanes scope
// queue visibility: TECHNICAL (Moodle Admin), ACADEMIC
// (lecturer/coordinator), ENROLMENT (Registry truth via the operating
// examinations office until a Registry demo role is approved).
model GradeFinding {
  id String @id @default(uuid())
  batchId String
  batch GradeBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  lineId String?
  line GradeLine? @relation(fields: [lineId], references: [id], onDelete: Restrict)
  code String
  lane String
  status String @default("OPEN")
  version Int @default(1)
  detail Json @default("{}")
  ownerUnit String?
  escalationDeadline DateTime?
  createdByAccountId String
  resolvedByAccountId String?
  resolvedAt DateTime?
  resolveReason String?
  createdAt DateTime @default(now())
  @@index([batchId, status])
  @@index([status, code])
}

// Phase 7 slice 4: lecturer correction and moderation handoff
// (TASK-PH7-004). Validated batches submit with a recorded declaration;
// cases move SUBMITTED→UNDER_MODERATION→APPROVED/RETURNED/
