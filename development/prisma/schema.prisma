  type                String    // TOTP | BACKUP_CODES
  secretEncrypted     String?   // TOTP secret (encrypted at rest)
  backupCodesEncrypted String?  // JSON array of hashed backup codes
  enrolledAt          DateTime  @default(now())
  lastUsedAt          DateTime?
  disabledAt          DateTime?

  @@index([accountId])
}

// Step-up authentication challenges for high-risk actions
model StepUpChallenge {
  id            String    @id @default(uuid())
  accountId     String
  challengeId   String    @unique
  type          String    // TOTP | PUSH | CODE
  targetAction  String    // e.g., 'finance.adjustment.approve', 'admissions.decision.release'
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([accountId, targetAction])
  @@index([expiresAt])
}

// Multiple recovery methods (accessible alternatives, not just email)
model RecoveryMethod {
  id          String    @id @default(uuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String    // EMAIL | PHONE | SECURITY_QUESTION | RECOVERY_CODE
  valueHash   String    // hashed contact value or security answer
  priority    Int       @default(1)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, type, priority])
  @@index([accountId])
}
