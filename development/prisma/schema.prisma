// SIS identity, catalogue and applicant persistence. Migrations are additive.
// Prisma 7+: connection URL lives in prisma.config.ts (schema holds provider only).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Identity-access core (TASK-PH1-001). Person is authoritative — the username
// on Account is a login handle only (REQ-IAM-001). Role assignments carry
// scope, effective dates, issuer, reason and revocation (REQ-IAM-003).

model Person {
  id              String    @id @default(uuid())
  displayName     String
  // Approved contact channels (§12.8); verification timestamps filled by
  // verification flows in later slices. Fictional demo values only.
  email           String?
  emailVerifiedAt DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]
  // Phase 4 slice 2: duplicate-identity handling. A person merged into
  // another keeps its row (history preserved); duplicateOfPersonId points at
  // the surviving record. Status ACTIVE by default.
  status             String  @default("ACTIVE")
  duplicateOfPersonId String?
  duplicateOf        Person?  @relation("PersonDuplicate", fields: [duplicateOfPersonId], references: [id], onDelete: Restrict)
  duplicates         Person[] @relation("PersonDuplicate")
  student            Student?
}

model Account {
  id           String           @id @default(uuid())
  personId     String
  person       Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  username     String           @unique
  status       String           @default("ACTIVE")
  // Sign-in abuse tracking (07/04 baselines, SECURITY-v1 values in code).
  failedSignInCount Int      @default(0)
  lockedUntil       DateTime?
  createdAt    DateTime         @default(now())
  roles        RoleAssignment[] @relation("Grantee")
  grantsIssued RoleAssignment[] @relation("Grantor")
  approvals    RoleAssignment[] @relation("Approver")
  credentials  Credential[]
  sessions     Session[]
  recoveryTokens RecoveryToken[]
  recoverySuspicions RecoverySuspicion[]
  recoveryReviewQueue RecoveryReviewQueue[]
  applications Application[]
  teachingAssignments TeachingAssignment[]
  // Phase 7 slice 2: staged lines resolved to this account by username
  // when no student number matched (still converts, never official).
  resolvedGradeLines GradeLine[]
  recoveryMethods RecoveryMethod[]
  timetableDemoRuleDrafts TimetableDemoRuleDraft[]
  timetableDemoMasterDrafts TimetableDemoMasterDraft[]

  @@index([personId])
}

// Secrets live here — never overwritten in place. A password/TOTP change
// creates a new row and supersedes the old one (preserve-history rule).
// Kinds: PASSWORD today; TOTP and RECOVERY_CODE arrive with slice 2/2b.
// Extra-SQL hardening (see ph1_hardening migration, kept in sync by hand):
// partial UNIQUE(accountId, kind) WHERE ACTIVE on Credential (Prisma cannot
// express partial indexes). AuditEvent correlationId NOT NULL UNIQUE is now
// enforced in-schema (@unique). `migrate diff` will flag the Credential one;
// never auto-drop.
model Credential {
  id           String    @id @default(uuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         String
  secretHash   String
  status       String    @default("ACTIVE")
  supersededAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([accountId, kind, status])
}

model RoleAssignment {
  id          String   @id @default(uuid())
  accountId   String
  account     Account  @relation("Grantee", fields: [accountId], references: [id], onDelete: Restrict)
  role        String
  scopeType   String
  scopeRef    String
  // New: link to Scope entity for institutional hierarchy (Task 1.3)
  scopeId     String?
  scope       Scope?   @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  grantedById String?
  grantedBy   Account? @relation("Grantor", fields: [grantedById], references: [id], onDelete: SetNull)
  // §12.9 grant-form fields: appointment evidence, authority source, approved
  // capabilities, acting/permanent status, delegation limit, required approver.
  appointmentRef  String?
  authoritySource String?
  capabilities    String[]
  employmentType  String?
  delegationLimit String?
  approverId      String?
  approver        Account? @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)
  reason            String
  revokedAt         DateTime?
  revokeReason      String?
  createdAt         DateTime  @default(now())
  sessions          Session[] @relation("ActiveAssignment")
  academicServices  AcademicSupportService[] @relation("AcademicServiceOwner")
  advisees          StudentAdviserAssignment[] @relation("StudentAdviser")
  academicRequests  AcademicSupportRequest[] @relation("AcademicRequestOwner")

  @@index([accountId])
  @@index([role, scopeType, scopeRef])
  @@index([accountId, role, scopeType, scopeRef])
  @@index([scopeId])
}

// Capability registry (GAP-003): allowed capabilities + metadata
model Capability {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String   // e.g., 'TEACHING', 'ADMIN', 'FINANCE', 'ADMISSIONS'
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scopes      CapabilityScope[]
  authorities ApproverAuthority[]
  scopeLinks  Scope[]  // Direct capabilityId on Scope

  @@index([category, isActive])
}

// Scope hierarchy (GAP-004): institutional org units with parent-child relationships
model Scope {
  id              String    @id @default(uuid())
  name            String    @unique // e.g., 'SYSTEM:GLOBAL', 'SCHOOL:ENGINEERING', 'DEPARTMENT:CS'
  description     String?
  parentScopeId   String?
  parentScope     Scope?    @relation("ScopeHierarchy", fields: [parentScopeId], references: [id], onDelete: Restrict)
  childScopes     Scope[]   @relation("ScopeHierarchy")
  capabilityId    String?
  capability      Capability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  capabilityLinks CapabilityScope[]
  authorities     ApproverAuthority[]
  roleAssignments RoleAssignment[] // Back-reference from RoleAssignment.scopeId

  @@index([parentScopeId])
  @@index([capabilityId])
  @@index([effectiveFrom, effectiveTo])
}

// Junction: Capability <-> Scope (many-to-many for capabilities applicable to scopes)
model CapabilityScope {
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  scopeId      String
  scope        Scope      @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([capabilityId, scopeId])
}

// ApproverAuthority: which role holds authority over which scope + capability (GAP-006)
model ApproverAuthority {
  id              String      @id @default(uuid())
  approverRoleId  String      // Role name that holds authority (e.g., 'DEAN', 'HOD', 'SYSADMIN')
  targetScopeId   String      // Scope they have authority over
  targetScope     Scope       @relation(fields: [targetScopeId], references: [id], onDelete: Restrict)
  capabilityId    String      // Capability this authority applies to
  capability      Capability  @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([approverRoleId, targetScopeId, capabilityId])
  @@index([approverRoleId])
  @@index([targetScopeId])
}

// SoDPair: mutually exclusive role pairs (GAP-012)
model SoDPair {
  id        String   @id @default(uuid())
  roleAId   String   // First role name (alphabetically first for consistency)
  roleBId   String   // Second role name
  reason    String   // Business justification
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleAId, roleBId])
  @@index([roleAId])
  @@index([roleBId])
}

model Session {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Active workspace pointer (slice 3, REQ-IAM-002). FK keeps authority live:
  // revocation/expiry of the assignment bites on next validation. Null means
  // no workspace selected (e.g. no live assignments). History stays in audit.
  activeAssignmentId String?
  activeAssignment   RoleAssignment? @relation("ActiveAssignment", fields: [activeAssignmentId], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdIp   String?
  userAgent   String?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([accountId])
  @@index([activeAssignmentId])
}

// Single-use account-recovery tokens (slice 2a). Only the hash is stored;
// the raw token is shown once to the requester (demo path) or sent via the
// future delivery provider. Expired or used tokens are rejected.
model RecoveryToken {
  id                 String    @id @default(uuid())
  tokenHash          String    @unique
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime  @default(now())
  recoverySuspicions RecoverySuspicion[]

  @@index([accountId])
}

// Recovery suspicion detection (GAP-011): records when a recovery attempt
// triggers suspicion signals (failed attempts, geo anomaly, device change,
// rate limiting). Risk score determines if routed to security review queue.
model RecoverySuspicion {
  id              String   @id @default(uuid())
  recoveryTokenId String?  // Null if suspicion detected before token creation
  recoveryToken   RecoveryToken? @relation(fields: [recoveryTokenId], references: [id], onDelete: SetNull)
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  signalType      String   // 'FAILED_ATTEMPTS' | 'GEO_ANOMALY' | 'DEVICE_CHANGE' | 'RATE_LIMIT' | 'MULTIPLE_SIGNALS'
  signalDetails   Json     // Structured details about the signal
  riskScore       Int      // 0-100, higher = more suspicious
  status          String   @default("PENDING") // 'PENDING' | 'QUEUED' | 'REVIEWED' | 'RESOLVED'
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewDecision  String?  // 'APPROVE' | 'DENY' | 'ESCALATE'
  reviewNote      String?
  reviewQueue     RecoveryReviewQueue?

  @@index([accountId, status])
  @@index([recoveryTokenId])
  @@index([createdAt])
}

// Security review queue for suspicious recoveries (GAP-011).
// Security Administrators review and decide on paused recoveries.
model RecoveryReviewQueue {
  id             String   @id @default(uuid())
  suspicionId    String   @unique
  suspicion      RecoverySuspicion @relation(fields: [suspicionId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  priority       String   @default("HIGH") // 'HIGH' | 'MEDIUM' | 'LOW'
  status         String   @default("PENDING") // 'PENDING' | 'CLAIMED' | 'DECIDED'
  assignedTo     String?
  createdAt      DateTime @default(now())
  claimedAt      DateTime?
  decidedAt      DateTime?
  decidedBy      String?
  decision       String?  // 'APPROVE' | 'DENY' | 'ESCALATE'
  decisionReason String?

  @@index([accountId, status])
  @@index([status, priority, createdAt])
  @@index([assignedTo, status])
}

model AuditEvent {
  id             String   @id @default(uuid())
  occurredAt     DateTime @default(now())
  actorAccountId String?
  activeRole     String?
  scope          String?
  action         String
  targetRef      String?
  outcome        String
  reason         String?
  policyVersion  String?
  // Slice-5 rebuild: correlationId is REQUIRED UNIQUE in schema (matches
  // hand-maintained hardening — support-reference lookups must hit exactly
  // one row). All writers set it (auditAuth mints randomUUID; services pass
  // explicit IDs). Remaining extra-SQL (see ph1_hardening migration, kept in
  // sync by hand): partial UNIQUE(accountId, kind) WHERE ACTIVE on
  // Credential. `migrate diff` will flag that one; never auto-drop.
  correlationId  String   @unique
  // Slice-4 purpose logging (§15.9): workflow-bound free text recorded at
  // decision time (grant reason, resolve context). No closed enum exists.
  purpose        String?
  // §16.14 + 07/02: error category, idempotency reference, prior/new state.
  errorCategory  String?
  idempotencyRef String?
  priorState     Json?
  newState       Json?
  metadata       Json?

  @@index([actorAccountId])
  @@index([action, occurredAt])
  @@index([correlationId])
}

// Client-generated idempotency keys (UI-SUBMIT-001 + high-impact rule):
// the same key returns the stored receipt instead of re-applying the effect.
model IdempotencyKey {
  key       String   @id
  accountId String
  action    String
  status    Int
  response  Json
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// Transactional outbox (architecture §18.6/18.7): domain row + event commit
// atomically; worker delivery (retry/dead-letter/replay UI) is v0.9
// (GAP-008/GAP-009). Consumers must tolerate duplicate delivery.
model OutboxEvent {
  id          String   @id @default(uuid())
  aggregate   String
  aggregateId String
  type        String
  payload     Json
  occurredAt  DateTime @default(now())
  deliveredAt DateTime?
  attempts    IntegrationDeliveryAttempt[]

  @@index([deliveredAt, occurredAt])
}

// Configuration Item - single source of truth for ALL configurable values
model ConfigurationItem {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String
  subCategory String?
  value       Json
  valueType   String
  label       String
  description String?
  minValue    Float?
  maxValue    Float?
  allowedValues Json?
  isSecret    Boolean  @default(false)
  isReadOnly  Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([category, subCategory])
  @@index([key])
}

// Configuration Version (for audit trail + rollback)
model ConfigurationVersion {
  id          String   @id @default(cuid())
  snapshot    Json
  changedBy   String
  changeReason String
  createdAt   DateTime @default(now())
}

// ADDITIVE ENTITIES for Phase 1 Slice 5

model ReviewSchedule {
  id           String   @id @default(uuid())
  assignmentId String
  reviewerId   String
  riskLevel    String   // e.g., 'high', 'medium', 'low'
  cadence      String   // e.g., 'quarterly', 'annual'
  nextDueAt    DateTime
  status       String   // e.g., 'pending', 'completed'
  decision     String?  // 'confirm' | 'reduce' | 'reassign' | 'revoke' | 'clarify'
  decidedAt    DateTime?
  decidedBy    String?

  @@index([nextDueAt, status])
}

model BreakGlassRequest {
  id              String   @id @default(uuid())
  requestorId     String
  incidentRef     String
  reason          String
  scope           String
  durationMinutes Int
  approverId      String
  status          String   // 'active', 'revoked', 'expired'
  grantedAt       DateTime @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  // Post-use review (§15.20 "reviewed"): filled by POST
  // /auth/break-glass/:id/review, never edited afterwards.
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewOutcome   String?  // 'justified' | 'excessive' | 'breach'
  reviewNote      String?

  @@index([expiresAt, status])
}

model ExpiryWarning {
  id             String   @id @default(uuid())
  assignmentId   String
  warnedAt       DateTime @default(now())
  acknowledgedAt DateTime?

  @@index([assignmentId, acknowledgedAt])
}
// Extra-SQL (hand-maintained, Prisma cannot express partial indexes):
// UNIQUE(assignmentId) WHERE acknowledgedAt IS NULL — one open warning per
// assignment across concurrent daemon ticks. See ph1_hardening comment rule:
// never auto-drop; mirror changes here.

model ExpiryDaemonState {
  id             String   @id @default(uuid())
  lastRunAt      DateTime
  nextRunAt      DateTime
  processedCount Int      @default(0)
}

// Public programme catalogue (TASK-PH2-001, applicant journey Part 2).
// Seed-local demo data under DEMO-ACADEMIC-2026-v1 until curriculum/
// organisation tables land (GAP-004: presence/format checks only, no
// registry validation). Availability vocabulary: OPEN | SOON | CLOSED |
// RETIRED. Requirement kinds: GRADE | BOOLEAN | TEXT.

model QualificationRoute {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  createdAt DateTime @default(now())
  rules     RequirementRule[]
}

model Programme {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  awardLevel       String
  school           String
  department       String?
  duration         String
  overview         String
  feeScheduleRef   String
  publishedVersion String
  effectiveDate    DateTime
  owningOffice     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  offerings        ProgrammeOffering[]
  rules            RequirementRule[]
  academicServices AcademicSupportService[]
}

model ProgrammeOffering {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  intake      String
  studyMode   String
  campus      String
  availability String  // OPEN | SOON | CLOSED | RETIRED
  deadline    DateTime?
  // Closed/unavailable explanation shown verbatim-safe (packet copy).
  statusNote  String?
  applications Application[]
  attempts ProgrammeAttempt[]
  tutorialGroups TutorialGroup[]
  teachingAssignments TeachingAssignment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([programmeId, intake, studyMode, campus])
  @@index([programmeId])
}

model RequirementRule {
  id                   String              @id @default(uuid())
  programmeId          String
  programme            Programme           @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  routeId              String?
  route                QualificationRoute? @relation(fields: [routeId], references: [id], onDelete: Restrict)
  ruleKey              String
  label                String
  kind                 String  // GRADE | BOOLEAN | TEXT
  mandatory            Boolean @default(true)
  minGrade             Int?
  requiresVerification Boolean @default(false)
  evidence             String
  version              Int     @default(1)
  createdAt            DateTime @default(now())

  @@unique([programmeId, ruleKey, version])
  @@index([programmeId])
}

// Transient anonymous guidance sessions (Part 2 §6.3): entered facts only,
// no personal data, short TTL, swept by expiry. Session-only retention.
model GuidanceSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  payload   Json

  @@index([expiresAt])
}

// Phase 2: applicant-owned drafts; the receipt/snapshot is immutable in SQL.
model Application {
  id String @id @default(uuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  offeringId String
  offering ProgrammeOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  reference String @unique
  state String @default("Created")
  version Int @default(1)
  policyVersion String
  requirementVersion String
  personal Json @default("{}")
  contact Json @default("{}")
  qualifications Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents ApplicationDocument[]
  submission ApplicationSubmission?
  revisions ApplicationRevision[]
  statusEvents ApplicationStatusEvent[]
  clarifications ApplicationClarification[]
  correctionRequests ApplicationCorrectionRequest[]
  decision ApplicationDecision?
  tickets SupportTicket[]
  withdrawal ApplicationWithdrawal?
  notifications ApplicantNotification[]
  reviewAssignments ReviewAssignment[]
  reviewFindings ReviewFinding[]
  recommendations ReviewRecommendation[]
  offerResponse ApplicationOfferResponse?
  onboardingTasks OnboardingTask[]
  @@index([accountId, updatedAt])
  @@index([offeringId])
  @@index([state, createdAt])
}
model ApplicationRevision {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  version Int
  section String
  data Json
  occurredAt DateTime @default(now())
  @@unique([applicationId, version])
}
model ApplicationDocument {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  category String
  fileName String
  mimeType String
  size Int
  // Restricted demo storage; null only when a reviewed object-store copy owns the bytes.
  content Bytes?
  bucket String
  key String
  sha256 String
  status String @default("SecurityScanPending")
  scanner String?
  version Int
  replacesId String? @unique
  replaces ApplicationDocument? @relation("Replacement", fields:[replacesId], references:[id], onDelete: Restrict)
  replacedBy ApplicationDocument? @relation("Replacement")
  replacementReason String?
  createdAt DateTime @default(now())
  @@index([applicationId, category, createdAt])
  @@index([bucket, key])
}
model ApplicationSubmission {
  id String @id @default(uuid())
  applicationId String @unique
  application Application @relation(fields: [applicationId], references:[id], onDelete: Restrict)
  reference String @unique
  snapshot Json
  receipt Json
  createdAt DateTime @default(now())
}
model ApplicationCommand {
  key String @id
  accountId String
  action String
  digest String
  status Int
  response Json
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

// Phase 2 slice 6: post-submit case. Status events are immutable rows (never
// mutate Application for history); staff-only rows stay out of applicant
// views by applicantVisible=false. All relations Restrict like the rest.
model ApplicationStatusEvent {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  occurredAt DateTime @default(now())
  code String
  label String
  detail String?
  actorRole String
  applicantVisible Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([applicationId, occurredAt])
}
model ApplicationClarification {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  question String
  deadline DateTime?
  response String?
  status String @default("OPEN")
  askedBy String @default("ADMISSIONS")
  askedAt DateTime @default(now())
  answeredAt DateTime?
  receipt String?
  @@index([applicationId, status])
}
model ApplicationCorrectionRequest {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  section String
  field String
  reason String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  @@index([applicationId, status])
}
model ApplicationDecision {
  id String @id @default(uuid())
  applicationId String @unique
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  outcome String
  message String
  conditions Json?
  // Offer version, explicit per the Phase 3 exit gate. A linked superseding
  // decision bumps it; decisions are never overwritten (slice 5 releases
  // version 1; re-release of the same decision is refused, not replaced).
  version Int @default(1)
  // Offer acceptance deadline (slice 6). Null only for legacy rows; the
  // release path always sets it. Late responses need an authorized extension.
  acceptBy DateTime?
  decidedAt DateTime @default(now())
  releasedAt DateTime?
  revisions ApplicationDecisionRevision[]
}

// Immutable released terms. ApplicationDecision is the current projection;
// each release/extension retains its full prior terms and authority.
model ApplicationDecisionRevision {
  id String @id @default(uuid())
  decisionId String
  decision ApplicationDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  version Int
  outcome String
  message String
  conditions Json?
  acceptBy DateTime?
  reason String
  actorAccountId String?
  createdAt DateTime @default(now())
  @@unique([decisionId, version])
}
model SupportTicket {
  id String @id @default(uuid())
  accountId String
  applicationId String?
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  subject String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  messages SupportTicketMessage[]
  @@index([accountId, createdAt])
}
model SupportTicketMessage {
  id String @id @default(uuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorRole String
  body String
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}
model ApplicationWithdrawal {
  id String @id @default(uuid())
  applicationId String @unique
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  reason String?
  receipt String
  withdrawnAt DateTime @default(now())
}
model ApplicantNotification {
  id String @id @default(uuid())
  accountId String
  applicationId String?
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  type String
  title String
  payload Json?
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([accountId, readAt])
}

// Phase 3 slice 1: staff review assignments. One active (CLAIMED) row per
// application, enforced by the partial unique index in migration
// 20260922120000_ph3_review_queue (Prisma cannot express it; same hand-
// maintained pattern as the Credential active-kind and ExpiryWarning
// acknowledgement partial uniques). History rows stay RELEASED.
model ReviewAssignment {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  assigneeAccountId String
  status String @default("CLAIMED")
  claimedAt DateTime @default(now())
  releasedAt DateTime?
  @@index([assigneeAccountId, status])
  @@index([status, applicationId])
}

// Phase 3 slice 2: immutable staff review findings. Findings describe review
// observations (COMPLETENESS, DECLARATION_MISMATCH, DOCUMENT_QUALITY,
// PAYMENT_STATUS, NOTE) with INFO/ACTION_NEEDED severity. They never modify
// applicant data; a mistaken finding is superseded by a new finding.
model ReviewFinding {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  kind String
  subject String
  detail String
  severity String @default("INFO")
  status String @default("OPEN")
  createdByAccountId String
  createdAt DateTime @default(now())
  @@index([applicationId, status])
}

// Phase 3 slice 4: eligibility and recommendation package. One ACTIVE row per
// application, enforced by the partial unique index in migration
// 20260923120000_ph3_recommendation (same hand-maintained pattern as
// ReviewAssignment). A new version supersedes the old row; history is never
// overwritten. createdByAccountId supports the slice-5 self-approval check.
model ReviewRecommendation {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  version Int
  eligibilityOutcome String
  recommendation String
  criteriaVersion String
  criteria Json?
  rationale String
  status String @default("ACTIVE")
  createdByAccountId String
  createdAt DateTime @default(now())
  decidedAt DateTime?
  @@index([applicationId, status])
}

// Phase 3 slice 6: immutable offer response. Exactly one row per application
// (unique applicationId, no update path): accept or decline, recorded once.
// A second response attempt receives the stored final status; decline is
// final unless an authorized reconsideration reopens it (later work).
model ApplicationOfferResponse {
  id String @id @default(uuid())
  applicationId String @unique
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  decision String
  reason String?
  receipt String
  respondedAt DateTime @default(now())
}

// Phase 3 slice 6: onboarding task list. Created from the demo task list when
// an offer is accepted. Applicant-owned tasks complete through the applicant
// case; institution-owned tasks stay pending until staff work completes them
// (later slices). No task here creates a student record (Phase 4 boundary).
model OnboardingTask {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  taskKey String
  title String
  owner String
  required Boolean @default(true)
  status String @default("PENDING")
  dueAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([applicationId, taskKey])
  @@index([applicationId, status])
}

// Phase 4 slice 2: student conversion (records module). A Student links one
// surviving Person to one human-readable student number; programme attempts
// track each admission on a published curriculum version. Conversion is
// idempotent and never auto-merges people (see IdentityMatchCandidate).
model Student {
  id String @id @default(uuid())
  personId String @unique
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  studentNumber String @unique
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts ProgrammeAttempt[]
  corrections StudentCorrectionRequest[]
  holds Hold[]
  clearances FinanceClearance[]
  financeAccount FinanceAccount?
  tgAllocations TGAllocation[]
  // Phase 7 slice 2: staged lines resolved to this student (DS5 §4
  // student/enrolment mapping; null stays MOODLE_ONLY evidence).
  resolvedGradeLines GradeLine[]
  advisers StudentAdviserAssignment[]
  academicRequests AcademicSupportRequest[]
  @@index([status, createdAt])
}

// V2 Task 6: academic help is separate from applicant tickets and from every
// restricted counselling/welfare/disability store. Routes are institution
// setup records; this slice accepts only explicit DEMO routes in DEMO_MODE.
model AcademicSupportService {
  id                String @id @default(uuid())
  programmeId       String
  programme         Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  campus            String
  name              String
  ownerAssignmentId String
  ownerAssignment   RoleAssignment @relation("AcademicServiceOwner", fields: [ownerAssignmentId], references: [id], onDelete: Restrict)
  status            String @default("DRAFT")
  demoOnly          Boolean @default(true)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  approvalRef       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  requests          AcademicSupportRequest[]

  @@index([programmeId, campus, status, effectiveFrom])
  @@index([ownerAssignmentId, status])
}

model StudentAdviserAssignment {
  id                  String @id @default(uuid())
  studentId           String
  student             Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  adviserAssignmentId String
  adviserAssignment   RoleAssignment @relation("StudentAdviser", fields: [adviserAssignmentId], references: [id], onDelete: Restrict)
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  sourceRef           String
  createdAt           DateTime @default(now())

  @@index([studentId, effectiveFrom, effectiveTo])
  @@index([adviserAssignmentId, effectiveFrom, effectiveTo])
}

model AcademicSupportRequest {
  id                String @id @default(uuid())
  reference         String @unique
  studentId         String
  student           Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  serviceId         String
  service           AcademicSupportService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  ownerAssignmentId String
  ownerAssignment   RoleAssignment @relation("AcademicRequestOwner", fields: [ownerAssignmentId], references: [id], onDelete: Restrict)
  category          String
  contactMethod     String
  details           String?
  noticeVersion     String
  status            String @default("RECEIVED")
  idempotencyKey    String @unique
  fingerprint       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  events            AcademicSupportRequestEvent[]
  messages          AcademicSupportMessage[]
  actions           AcademicSupportAction[]
  closure           AcademicSupportClosure?

  @@index([studentId, createdAt, id])
  @@index([ownerAssignmentId, createdAt, id])
  @@index([ownerAssignmentId, status, createdAt, id])
}

model AcademicSupportRequestEvent {
  id             String @id @default(uuid())
  requestId      String
  request        AcademicSupportRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  event          String
  actorAccountId String
  createdAt      DateTime @default(now())

  @@index([requestId, createdAt])
}

model AcademicSupportMessage {
  id             String @id @default(uuid())
  requestId      String
  request        AcademicSupportRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  authorAccountId String
  authorRole      String
  body            String
  idempotencyKey  String @unique
  fingerprint     String
  createdAt       DateTime @default(now())

  @@index([requestId, createdAt, id])
}

model AcademicSupportAction {
  id                String @id @default(uuid())
  requestId         String
  request           AcademicSupportRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  title             String
  explanation       String
  routeKey          String
  dueOn             String
  status            String @default("PROPOSED")
  proposerAccountId String
  proposalKey       String @unique
  fingerprint       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  events            AcademicSupportActionEvent[]

  @@index([requestId, status, dueOn, id])
  @@index([status, dueOn, id])
}

model AcademicSupportActionEvent {
  id             String @id @default(uuid())
  actionId       String
  action         AcademicSupportAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  event          String
  status         String
  actorAccountId String
  idempotencyKey String @unique
  fingerprint    String
  createdAt      DateTime @default(now())

  @@index([actionId, createdAt, id])
}

model AcademicSupportClosure {
  id             String @id @default(uuid())
  requestId      String @unique
  request        AcademicSupportRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  reason         String
  actorAccountId String
  idempotencyKey String @unique
  fingerprint    String
  createdAt      DateTime @default(now())
}

// Phase 4 slice 2: human identity-resolution queue. A candidate pairs the
// applicant's person with a possibly-matching existing person; records
// officers resolve (link or keep separate) with reason + audit. Rows are
// history and are never deleted.
model IdentityMatchCandidate {
  id String @id @default(uuid())
  applicationId String
  personId String
  candidatePersonId String
  reason String
  status String @default("PENDING")
  decidedByAccountId String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([applicationId, personId, candidatePersonId])
  @@index([status, createdAt])
  @@index([applicationId, status])
}

// Phase 4 slice 2: one programme attempt per admission. Status follows the
// Design Section 3 lifecycle (ADMITTED on conversion; later slices advance
// it). curriculumVersionId pins the published curriculum version.
model ProgrammeAttempt {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  applicationId String @unique
  offeringId String
  offering ProgrammeOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  intake String
  curriculumVersionId String?
  curriculumVersion CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  status String @default("ADMITTED")
  createdAt DateTime @default(now())
  @@index([studentId, status])
}

// Phase 4 slice 2: versioned curriculum. Only PUBLISHED versions receive new
// students; published rows are never edited in place (supersede instead).
model CurriculumVersion {
  id String @id @default(uuid())
  programmeId String
  version Int
  status String @default("PUBLISHED")
  effectiveFrom DateTime?
  rules Json?
  createdAt DateTime @default(now())
  attempts ProgrammeAttempt[]
  courses CurriculumCourse[]
  @@unique([programmeId, version])
  @@index([programmeId, status])
}

// Phase 4 slice 1: academic periods and student correction requests. Periods
// bound registration windows; corrections preserve old values with version
// history and never silently overwrite the person record.
model AcademicPeriod {
  id String @id @default(uuid())
  code String @unique
  registrationOpen DateTime?
  registrationClose DateTime?
  addDropClose DateTime?
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  invoices FinanceInvoice[]
  sponsorships FinanceSponsorship[]
  adjustments FinanceAdjustment[]
  arrangements FinanceArrangement[]
  deliveryOfferings CourseDeliveryOffering[]
  timetableDemoRuleDrafts TimetableDemoRuleDraft[]
  timetableDemoMasterDrafts TimetableDemoMasterDraft[]
  @@index([status, code])
}

model StudentCorrectionRequest {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  field String
  requestedValue String
  reason String
  status String @default("PENDING")
  decidedByAccountId String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  @@index([studentId, status])
}

// Phase 4 slice 3: holds and finance clearance reads. Holds block with an
// owning office and reason; clearance rows are written by Phase 5 (finance
// ledger) and read here as status + expiry only. Demo fixtures may insert
// clearance rows in tests; the Phase 5 writer replaces fixtures.
model Hold {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  holdType String
  effect String
  reason String
  office String
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  releasedAt DateTime?
  @@index([studentId, status])
}

model FinanceClearance {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  periodId String
  status String @default("NOT_ASSESSED")
  policyVersion String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId, periodId])
  @@index([studentId, status])
}

// Phase 5 slice 1: versioned fee assessment (TASK-PH5-001). One account
// per student; invoices group immutable posted charge lines per period.
// Money is integer minor units + currency, never floating point. Posted
// lines are never edited; later slices add reversals as new rows.
model FinanceAccount {
  id String @id @default(uuid())
  studentId String @unique
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  invoices FinanceInvoice[]
  paymentRequests FinancePaymentRequest[]
  paymentTransactions FinancePaymentTransaction[]
  reconciliationCases FinanceReconciliationCase[]
  allocations FinanceAllocation[]
  sponsorships FinanceSponsorship[]
  adjustments FinanceAdjustment[]
  arrangements FinanceArrangement[]
}

model FinanceInvoice {
  id String @id @default(uuid())
  accountId String
  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodId String
  period AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  reference String @unique
  policyVersion String
  status String @default("ISSUED")
  dueAt DateTime?
  createdAt DateTime @default(now())
  lines FinanceChargeLine[]
  paymentRequests FinancePaymentRequest[]
  @@unique([accountId, periodId])
  @@index([accountId, status])
}

model FinanceChargeLine {
  id String @id @default(uuid())
  invoiceId String
  invoice FinanceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  code String
  description String
  courseId String?
  course Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)
  amountMinor Int
  currency String @default("ZMW")
  feeRule String
  policyVersion String
  inputs Json?
  status String @default("POSTED")
  createdAt DateTime @default(now())
  allocations FinanceAllocation[]
  @@index([invoiceId, status])
}

// Phase 5 slice 3: payment initiation and simulator staging (TASK-PH5-003).
// Requests are student-initiated with idempotency references; uncertain
// requests block re-initiation ("do not pay again"). Simulator transactions
// are staged provider evidence, never confirmation (slice 4 confirms).
model FinancePaymentRequest {
  id String @id @default(uuid())
  accountId String
  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  invoiceId String
  invoice FinanceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reference String @unique
  amountMinor Int
  currency String @default("ZMW")
  method String
  status String @default("AWAITING_CONFIRMATION")
  idempotencyKey String @unique
  simulatorScenario String?
  payerReference String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions FinancePaymentTransaction[]
  @@index([accountId, status])
  @@index([invoiceId, status])
}

model FinancePaymentTransaction {
  id String @id @default(uuid())
  requestId String?
  request FinancePaymentRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  accountId String
  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  provider String
  providerRef String @unique
  amountMinor Int
  currency String @default("ZMW")
  channel String
  status String @default("STAGED")
  signatureValid Boolean?
  evidence Json?
  createdAt DateTime @default(now())
  allocations FinanceAllocation[]
  originalReversal FinancePaymentReversal? @relation("ReversedOriginal")
  reversalEntry FinancePaymentReversal? @relation("ReversalEntry")
  @@index([accountId, status])
}

model FinancePaymentReversal {
  id String @id @default(uuid())
  originalTransactionId String @unique
  originalTransaction FinancePaymentTransaction @relation("ReversedOriginal", fields: [originalTransactionId], references: [id], onDelete: Restrict)
  reversalTransactionId String @unique
  reversalTransaction FinancePaymentTransaction @relation("ReversalEntry", fields: [reversalTransactionId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

// Phase 5 slice 4: callbacks and reconciliation cases (TASK-PH5-004).
// Callbacks are normalized once (nonce-tracked); mismatches and unknown
// references open cases instead of moving money. Cases preserve source
// evidence; resolution arrives in slice 6 and never deletes originals.
model FinanceCallback {
  id String @id @default(uuid())
  provider String
  providerRef String
  nonce String
  status String
  receivedAt DateTime @default(now())
  @@unique([provider, nonce])
  @@index([provider, providerRef])
}

model FinanceReconciliationCase {
  id String @id @default(uuid())
  accountId String?
  account FinanceAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  requestId String?
  kind String
  status String @default("OPEN")
  providerRef String?
  detail Json?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([status, createdAt])
  @@index([status, createdAt, id])
  @@index([accountId, status])
}

// Phase 5 slice 5: allocation and clearance (TASK-PH5-005). Allocations
// link posted payments to charge lines under the policy version; the
// balance always recomputes from posted lines minus allocations. Sponsorship
// rows are written by slice 6 officers; the clearance calculator already
// consumes confirmed coverage (promise is never cash).
model FinanceAllocation {
  id String @id @default(uuid())
  accountId String
  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paymentTransactionId String
  paymentTransaction FinancePaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  chargeLineId String
  chargeLine FinanceChargeLine @relation(fields: [chargeLineId], references: [id], onDelete: Restrict)
  amountMinor Int
  policyVersion String
  createdAt DateTime @default(now())
  reversal FinanceAllocationReversal?
  @@unique([paymentTransactionId, chargeLineId])
  @@index([chargeLineId])
  @@index([accountId])
}

// Reversal is a compensating row. The original allocation remains available
// for historical reproduction and is excluded only from current balances.
model FinanceAllocationReversal {
  id String @id @default(uuid())
  allocationId String @unique
  allocation FinanceAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  providerRef String
  nonce String
  amountMinor Int
  createdAt DateTime @default(now())
}


// Phase 5 slice 6: finance governance (TASK-PH5-006). Adjustments follow
// request → threshold approval with maker/checker separation; approved
// credits post compensating charge lines, never edits. Arrangements are
// student-requested, approver-decided clearance entitlements.
model FinanceAdjustment {
  id String @id @default(uuid())
  accountId String
  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodId String
  period AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  kind String
  amountMinor Int
  currency String @default("ZMW")
  reason String
  evidenceNote String?
  status String @default("REQUESTED")
  policyVersion String
  requesterAccountId String
  deciderAccountId String?
  decidedAt DateTime?
  payoutReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([accountId, status])
  @@index([status, kind, createdAt, id])
}

// Phase 6 slice 0: tutorial-group and teaching-assignment sources
// (TASK-PH6-000). SIS-authoritative academic data; Moodle mirrors it from
// slice 3 on. TGs activate only with a tutor; allocations carry reasons
// and never over-enrol. Quiz authority derives from explicit assignment
// capability + scope + dates. Timetable-conflict checks have no source
// (GAP-021).
model TutorialGroup {
  id String @id @default(uuid())
  offeringId String
  offering ProgrammeOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  name String
  capacity Int
  meetingPattern String?
  tutorRequirement String?
  venue String?
  mode String?
  allocationRule String?
  effectiveDate DateTime?
  status String @default("DRAFT")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  allocations TGAllocation[]
  assignments TeachingAssignment[]
  @@unique([offeringId, name])
  @@index([offeringId, status])
}

model TGAllocation {
  id String @id @default(uuid())
  groupId String
  group TutorialGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  reason String
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  @@unique([groupId, studentId])
  @@index([groupId, status])
  @@index([studentId, status])
}

// Phase 6 slice 1: mapping registry and connection health
// (TASK-PH6-001). Mappings bind both SIS and Moodle identifiers with
// versions; activation is four-eyes with synthetic validation. The
// connection row carries health, never secrets.
model MoodleConnection {
  id String @id @default(uuid())
  provider String @unique
  baseUrl String?
  status String @default("HEALTHY")
  capabilities Json?
  lastCheckedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MoodleMapping {
  id String @id @default(uuid())
  kind String
  sisType String
  sisId String
  moodleId String
  version Int @default(1)
  status String @default("DRAFT")
  creatorAccountId String
  activatorAccountId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  checks MappingCheck[]
  @@index([kind, sisType, sisId, status])
  @@index([status, updatedAt])
}

// Phase 6 slice 2: delivery attempts (TASK-PH6-002). The outbox stays
// an immutable log; each delivery attempt tracks state, retries and
// errors here. Envelopes (idempotency, correlation, payload version)
// travel inside outbox payloads (see registration envelope writes).
model IntegrationDeliveryAttempt {
  id String @id @default(uuid())
  outboxId String
  outbox OutboxEvent @relation(fields: [outboxId], references: [id], onDelete: Restrict)
  state String @default("PENDING")
  attempt Int @default(0)
  nextRunAt DateTime?
  lastError String?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([state, nextRunAt])
  @@index([outboxId])
}

// Phase 6 slice 3: simulator actual-state projections (TASK-PH6-003).
// MOODLE-SIM-v1 holds shells, enrolments and group mirrors as the
// "actual" side; SIS rows are "expected" (slice 6 compares them).
// Learning history is retained: removals suspend, never delete.
model SimShell {
  id String @id @default(uuid())
  shellRef String @unique
  offeringId String
  periodId String
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  enrolments SimStudentEnrolment[]
  staffRoles SimStaffRole[]
  groupMembers SimGroupMember[]
  @@unique([offeringId, periodId])
  @@index([status])
}

model SimStudentEnrolment {
  id String @id @default(uuid())
  shellId String
  shell SimShell @relation(fields: [shellId], references: [id], onDelete: Restrict)
  studentId String
  role String @default("Student")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shellId, studentId])
  @@index([studentId, status])
}

model SimStaffRole {
  id String @id @default(uuid())
  shellId String
  shell SimShell @relation(fields: [shellId], references: [id], onDelete: Restrict)
  accountId String
  moodleRole String
  quizScope Json?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shellId, accountId])
  @@index([accountId, status])
}

// Phase 6 slice 4: maintenance windows (TASK-PH6-004). Windows are
// scheduled through approved change; the worker defers deliveries inside
// an active window and health reports MAINTENANCE with student-safe
// wording. Windows are never edited, only cancelled or completed.
// Phase 6 slice 5: replay decisions and incidents (TASK-PH6-005).
// Replays are decision-page approvals with frozen evidence and a
// declaration, four-eyes separated. Incidents close only with recovery
// evidence. Nothing here edits source records or deletes queue rows.
// Phase 6 slice 6: reconciliation runs and cases (TASK-PH6-006).
// Runs compare SIS expected against simulator actual; safe diffs
// auto-repair by requeueing delivery, everything else opens governed
// cases. Closure needs delivery confirmation or a linked domain action.
model ReconciliationRun {
  id String @id @default(uuid())
  scope String @default("FULL")
  status String @default("RUNNING")
  summary Json?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  cases ReconciliationCase[]
  @@index([status, startedAt])
}

model ReconciliationCase {
  id String @id @default(uuid())
  runId String?
  run ReconciliationRun? @relation(fields: [runId], references: [id], onDelete: Restrict)
  kind String
  status String @default("OPEN")
  studentId String?
  shellId String?
  detail Json?
  resolution String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, kind])
  @@index([studentId, status])
}

model ReplayDecision {
  id String @id @default(uuid())
  scope String
  attemptId String?
  rangeFrom DateTime?
  rangeTo DateTime?
  evidence Json
  declaration String
  status String @default("PENDING")
  requesterAccountId String
  deciderAccountId String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}

model IntegrationIncident {
  id String @id @default(uuid())
  title String
  severity String
  status String @default("OPEN")
  ownerAccountId String?
  detail Json?
  closureEvidence String?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model MoodleMaintenance {
  id String @id @default(uuid())
  reason String
  startsAt DateTime
  endsAt DateTime
  status String @default("SCHEDULED")
  creatorAccountId String
  createdAt DateTime @default(now())
  @@index([status, startsAt])
}

model SimGroupMember {
  id String @id @default(uuid())
  shellId String
